type env struct {
	t       *testing.T
	h       http.Handler
	backend storage.Backend
	reqs    *reqlog.Store
	faults  *faults.Engine
}

func newEnv(t *testing.T, mod ...func(*Deps)) *env {
	t.Helper()
	d := Deps{
		Backend:  memory.New(),
		Requests: reqlog.NewStore(100),
		Faults:   faults.NewEngine(),
		Info: Info{
			Version: "0.1.0", Region: "us-east-1", Storage: "memory", S3Port: 9000, ConsolePort: 9001,
			AccessKey: "s3lab", RequestLogCapacity: 100,
			StartedAt: time.Date(2026, 10, 19, 12, 0, 0, 0, time.UTC),
		},
	}
	for _, m := range mod {
		m(&d)
	}
	return &env{t: t, h: New(d), backend: d.Backend, reqs: d.Requests, faults: d.Faults}
}

type resp struct {
	*httptest.ResponseRecorder
	t *testing.T
}

func (e *env) do(method, target, body string, hdr ...string) resp {
	e.t.Helper()
	var rd io.Reader
	if body != "" {
		rd = strings.NewReader(body)
	}
	req := httptest.NewRequest(method, target, rd)
	req.Host = "localhost:9001"
	for i := 0; i+1 < len(hdr); i += 2 {
		req.Header.Set(hdr[i], hdr[i+1])
	}
	rec := httptest.NewRecorder()
	e.h.ServeHTTP(rec, req)
	return resp{rec, e.t}
}

func (r resp) json() map[string]any {
	var m map[string]any
	require.NoError(r.t, json.Unmarshal(r.Body.Bytes(), &m))
	return m
}

func (r resp) errCode() string {
	m := r.json()
	em, _ := m["error"].(map[string]any)
	code, _ := em["code"].(string)
	return code
}

func (e *env) mustBucket(name string) {
	e.t.Helper()
	require.NoError(e.t, e.backend.CreateBucket(context.Background(), name))
}

func (e *env) mustPut(bucket, key, body, ct string) {
	e.t.Helper()
	_, err := e.backend.PutObject(context.Background(), bucket, key, strings.NewReader(body),
		storage.PutOptions{Size: int64(len(body)), Meta: storage.ObjectMeta{ContentType: ct}})
	require.NoError(e.t, err)
}

func TestHealthInfo(t *testing.T) {
	e := newEnv(t)
	r := e.do("GET", "/_s3lab/health", "")
	require.Equal(t, 200, r.Code)
	require.Equal(t, "application/json", r.Header().Get("Content-Type"))
	require.Equal(t, "ok", r.json()["status"])
	require.Equal(t, "0.1.0", r.json()["version"])

	m := e.do("GET", "/_s3lab/info", "").json()
	require.Equal(t, "2026-10-19T12:00:00.000Z", m["startedAt"])
	require.Equal(t, float64(9001), m["consolePort"])
	require.Equal(t, "s3lab", m["accessKey"])
	require.Equal(t, "memory", m["storage"])
	require.Contains(t, m, "virtualHostDomain")
	require.NotContains(t, m, "secretKey")
}

func TestBuckets(t *testing.T) {
	e := newEnv(t)
	r := e.do("GET", "/_s3lab/buckets", "")
	require.Equal(t, 200, r.Code)
	require.JSONEq(t, `{"buckets":[]}`, r.Body.String())

	r = e.do("POST", "/_s3lab/buckets", `{"name":"photos"}`)
	require.Equal(t, 201, r.Code)
	require.Equal(t, "photos", r.json()["name"])
	require.Regexp(t, `^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$`, r.json()["createdAt"])

	r = e.do("POST", "/_s3lab/buckets", `{"name":"photos"}`)
	require.Equal(t, 409, r.Code)
	require.Equal(t, "BucketAlreadyOwnedByYou", r.errCode())

	r = e.do("POST", "/_s3lab/buckets", `{"name":"X"}`)
	require.Equal(t, 400, r.Code)
	require.Equal(t, "InvalidBucketName", r.errCode())

	r = e.do("POST", "/_s3lab/buckets", `not json`)
	require.Equal(t, 400, r.Code)
	require.Equal(t, "BadRequest", r.errCode())

	r = e.do("POST", "/_s3lab/buckets", `{"name":"`+strings.Repeat("a", 2<<20)+`"}`)
	require.Equal(t, 400, r.Code)

	list := e.do("GET", "/_s3lab/buckets", "").json()["buckets"].([]any)
	require.Len(t, list, 1)

	e.mustPut("photos", "a.txt", "x", "text/plain")
	r = e.do("DELETE", "/_s3lab/buckets/photos", "")
	require.Equal(t, 409, r.Code)
	require.Equal(t, "BucketNotEmpty", r.errCode())

	r = e.do("DELETE", "/_s3lab/buckets/photos?force=true", "")
	require.Equal(t, 204, r.Code)
	r = e.do("DELETE", "/_s3lab/buckets/photos", "")
	require.Equal(t, 404, r.Code)
	require.Equal(t, "NoSuchBucket", r.errCode())
	r = e.do("DELETE", "/_s3lab/buckets/photos?force=true", "")
	require.Equal(t, 404, r.Code)

	e.mustBucket("empty")
	require.Equal(t, 204, e.do("DELETE", "/_s3lab/buckets/empty", "").Code)
}

func TestListObjects(t *testing.T) {
	e := newEnv(t)
	e.mustBucket("photos")
	e.mustPut("photos", "a/b.jpg", "12345", "image/jpeg")
	e.mustPut("photos", "a/sub/c.jpg", "1", "image/jpeg")
	e.mustPut("photos", "top.txt", "1", "")

	m := e.do("GET", "/_s3lab/buckets/photos/objects", "").json()
	require.Len(t, m["objects"], 1)
	require.Equal(t, []any{"a/"}, m["prefixes"])
	require.Equal(t, false, m["isTruncated"])
	require.Equal(t, "", m["nextStartAfter"])
	obj := m["objects"].([]any)[0].(map[string]any)
	require.Equal(t, "top.txt", obj["key"])
	require.Equal(t, "application/octet-stream", obj["contentType"])

	m = e.do("GET", "/_s3lab/buckets/photos/objects?prefix=a/", "").json()
	require.Len(t, m["objects"], 1)
	require.Equal(t, []any{"a/sub/"}, m["prefixes"])
	obj = m["objects"].([]any)[0].(map[string]any)
	require.Equal(t, "a/b.jpg", obj["key"])
	require.Equal(t, float64(5), obj["size"])
	require.NotEmpty(t, obj["etag"])
	require.NotEmpty(t, obj["lastModified"])

	m = e.do("GET", "/_s3lab/buckets/photos/objects?delimiter=", "").json()
	require.Len(t, m["objects"], 3)
	require.Empty(t, m["prefixes"])

	m = e.do("GET", "/_s3lab/buckets/photos/objects?delimiter=&maxKeys=2", "").json()
	require.Len(t, m["objects"], 2)
	require.Equal(t, true, m["isTruncated"])
	next := m["nextStartAfter"].(string)
	require.NotEmpty(t, next)
	m = e.do("GET", "/_s3lab/buckets/photos/objects?delimiter=&maxKeys=2&startAfter="+next, "").json()
	require.Len(t, m["objects"], 1)
	require.Equal(t, false, m["isTruncated"])

	require.Equal(t, 400, e.do("GET", "/_s3lab/buckets/photos/objects?maxKeys=abc", "").Code)
	require.Equal(t, 200, e.do("GET", "/_s3lab/buckets/photos/objects?maxKeys=99999", "").Code)
	r := e.do("GET", "/_s3lab/buckets/nope/objects", "")
	require.Equal(t, 404, r.Code)
	require.Equal(t, "NoSuchBucket", r.errCode())
}

func TestObjectCRUD(t *testing.T) {
	e := newEnv(t)
	e.mustBucket("photos")

	r := e.do("PUT", "/_s3lab/buckets/photos/object?key=a%2Fb.txt", "hello",
		"Content-Type", "text/plain", "X-Amz-Meta-Owner", "leo")
	require.Equal(t, 201, r.Code)
	m := r.json()
	require.Equal(t, "a/b.txt", m["key"])
	require.Equal(t, float64(5), m["size"])
	require.Equal(t, "text/plain", m["contentType"])
	require.Equal(t, map[string]any{"owner": "leo"}, m["metadata"])
	require.Equal(t, map[string]any{}, m["headers"])
	require.Equal(t, "5d41402abc4b2a76b9719d911017c592", m["etag"])

	r = e.do("PUT", "/_s3lab/buckets/photos/object?key=bin", "x")
	require.Equal(t, 201, r.Code)
	require.Equal(t, "application/octet-stream", r.json()["contentType"])

	info, err := e.backend.HeadObject(context.Background(), "photos", "bin")
	require.NoError(t, err)
	info.Meta.CacheControl = "max-age=60"
	_, err = e.backend.PutObject(context.Background(), "photos", "cc", strings.NewReader("y"),
		storage.PutOptions{Size: 1, Meta: info.Meta})
	require.NoError(t, err)
	m = e.do("GET", "/_s3lab/buckets/photos/object?key=cc", "").json()
	require.Equal(t, map[string]any{"Cache-Control": "max-age=60"}, m["headers"])
	require.Equal(t, float64(0), m["partsCount"])

	r = e.do("GET", "/_s3lab/buckets/photos/object?key=a/b.txt", "")
	require.Equal(t, 200, r.Code)
	require.Equal(t, "text/plain", r.json()["contentType"])

	r = e.do("GET", "/_s3lab/buckets/photos/object?key=missing", "")
	require.Equal(t, 404, r.Code)
	require.Equal(t, "NoSuchKey", r.errCode())
	r = e.do("GET", "/_s3lab/buckets/photos/object", "")
	require.Equal(t, 400, r.Code)
	require.Equal(t, 400, e.do("PUT", "/_s3lab/buckets/photos/object", "x").Code)
	require.Equal(t, 400, e.do("DELETE", "/_s3lab/buckets/photos/object", "").Code)
	require.Equal(t, 400, e.do("GET", "/_s3lab/buckets/photos/download", "").Code)
	require.Equal(t, 404, e.do("PUT", "/_s3lab/buckets/nope/object?key=a", "x").Code)
	require.Equal(t, 404, e.do("GET", "/_s3lab/buckets/nope/object?key=a", "").Code)
	r = e.do("PUT", "/_s3lab/buckets/photos/object?key="+strings.Repeat("k", 2000), "x")
	require.Equal(t, 400, r.Code)

	require.Equal(t, 204, e.do("DELETE", "/_s3lab/buckets/photos/object?key=a/b.txt", "").Code)
	require.Equal(t, 204, e.do("DELETE", "/_s3lab/buckets/photos/object?key=a/b.txt", "").Code)
	require.Equal(t, 404, e.do("GET", "/_s3lab/buckets/photos/object?key=a/b.txt", "").Code)
	require.Equal(t, 404, e.do("DELETE", "/_s3lab/buckets/nope/object?key=a", "").Code)
}

func TestDeletePrefix(t *testing.T) {
	e := newEnv(t)
	e.mustBucket("photos")
	for i := range 1005 {
		e.mustPut("photos", "tmp/"+strings.Repeat("x", 3)+string(rune('a'+i%26))+"-"+itoa(i), "x", "")
	}
	e.mustPut("photos", "keep.txt", "x", "")

	r := e.do("DELETE", "/_s3lab/buckets/photos/objects?prefix=tmp/", "")
	require.Equal(t, 200, r.Code)
	require.Equal(t, float64(1005), r.json()["deleted"])
	m := e.do("GET", "/_s3lab/buckets/photos/objects?delimiter=", "").json()
	require.Len(t, m["objects"], 1)

	r = e.do("DELETE", "/_s3lab/buckets/photos/objects", "")
	require.Equal(t, float64(1), r.json()["deleted"])
	require.Equal(t, 404, e.do("DELETE", "/_s3lab/buckets/nope/objects", "").Code)
}

func itoa(i int) string {
	b, _ := json.Marshal(i)
	return string(b)
}

func TestDownload(t *testing.T) {
	e := newEnv(t)
	e.mustBucket("photos")
	e.mustPut("photos", "a/b.html", "<script>alert(1)</script>", "text/html")
	e.mustPut("photos", "dir/ação \"x\".txt", "olá", "text/plain")

	r := e.do("GET", "/_s3lab/buckets/photos/download?key=a/b.html", "")
	require.Equal(t, 200, r.Code)
	require.Equal(t, "<script>alert(1)</script>", r.Body.String())
	require.Equal(t, "text/html", r.Header().Get("Content-Type"))
	require.Equal(t, `attachment; filename="b.html"`, r.Header().Get("Content-Disposition"))
	require.Equal(t, "25", r.Header().Get("Content-Length"))
	require.NotEmpty(t, r.Header().Get("ETag"))
	require.Equal(t, "nosniff", r.Header().Get("X-Content-Type-Options"))
	require.Empty(t, r.Header().Get("Content-Security-Policy"))

	r = e.do("GET", "/_s3lab/buckets/photos/download?key=a/b.html&inline=1", "")
	require.Equal(t, `inline; filename="b.html"`, r.Header().Get("Content-Disposition"))
	require.Equal(t, "sandbox", r.Header().Get("Content-Security-Policy"))

	r = e.do("GET", "/_s3lab/buckets/photos/download?key="+"dir/a%C3%A7%C3%A3o%20%22x%22.txt", "")
	require.Equal(t, 200, r.Code)
	require.Equal(t, `attachment; filename="a__o _x_.txt"; filename*=UTF-8''a%C3%A7%C3%A3o%20%22x%22.txt`,
		r.Header().Get("Content-Disposition"))

	r = e.do("GET", "/_s3lab/buckets/photos/download?key=nope", "")
	require.Equal(t, 404, r.Code)
	require.Equal(t, "NoSuchKey", r.errCode())
}

func TestRequests(t *testing.T) {
	e := newEnv(t)
	for _, en := range []reqlog.Entry{
		{Time: time.Date(2026, 1, 1, 0, 0, 0, 123456789, time.UTC), Method: "PUT", Op: "PutObject", Bucket: "a", Key: "k/1", Status: 200},
		{Method: "GET", Op: "GetObject", Bucket: "a", Key: "z", Status: 404, ErrorCode: "NoSuchKey"},
		{Method: "GET", Op: "ListBuckets", Status: 200},
		{Method: "PUT", Op: "PutObject", Bucket: "b", Key: "k/2", Status: 503},
	} {
		e.reqs.Add(en)
	}
	count := func(q string) int {
		r := e.do("GET", "/_s3lab/requests"+q, "")
		require.Equal(t, 200, r.Code)
		return len(r.json()["entries"].([]any))
	}
	require.Equal(t, 4, count(""))
	require.Equal(t, 2, count("?bucket=a"))
	require.Equal(t, 2, count("?op=PutObject"))
	require.Equal(t, 2, count("?key=k/"))
	require.Equal(t, 1, count("?status=404"))
	require.Equal(t, 2, count("?errors=true"))
	require.Equal(t, 2, count("?since=2"))
	require.Equal(t, 1, count("?limit=1"))
	for _, bad := range []string{"?status=x", "?since=-1", "?limit=x"} {
		require.Equal(t, 400, e.do("GET", "/_s3lab/requests"+bad, "").Code, bad)
	}

	first := e.do("GET", "/_s3lab/requests?limit=4", "").json()["entries"].([]any)[0].(map[string]any)
	require.Equal(t, float64(1), first["id"])
	require.Equal(t, "2026-01-01T00:00:00.123Z", first["time"])

	require.Equal(t, 204, e.do("DELETE", "/_s3lab/requests", "").Code)
	require.Equal(t, 0, count(""))
	require.JSONEq(t, `{"entries":[]}`, e.do("GET", "/_s3lab/requests", "").Body.String())
}

func TestFaults(t *testing.T) {
	e := newEnv(t)
	require.JSONEq(t, `{"rules":[]}`, e.do("GET", "/_s3lab/faults", "").Body.String())

	r := e.do("POST", "/_s3lab/faults", `{"id":"f1","op":"PutObject","status":503,"unknown":1}`)
	require.Equal(t, 201, r.Code)
	require.Equal(t, "f1", r.json()["id"])
	require.Equal(t, "SlowDown", r.json()["code"])

	r = e.do("POST", "/_s3lab/faults", `{"id":"f1","status":500}`)
	require.Equal(t, 409, r.Code)
	require.Equal(t, "Conflict", r.errCode())

	r = e.do("POST", "/_s3lab/faults", `{"status":200}`)
	require.Equal(t, 400, r.Code)
	require.Equal(t, "BadRequest", r.errCode())
	require.Equal(t, 400, e.do("POST", "/_s3lab/faults", `{`).Code)

	r = e.do("POST", "/_s3lab/faults", `{"delayMs":5}`)
	require.Equal(t, 201, r.Code)
	require.Regexp(t, `^f-`, r.json()["id"])
	require.Len(t, e.do("GET", "/_s3lab/faults", "").json()["rules"], 2)

	require.Equal(t, 204, e.do("DELETE", "/_s3lab/faults/f1", "").Code)
	r = e.do("DELETE", "/_s3lab/faults/f1", "")
	require.Equal(t, 404, r.Code)
	require.Equal(t, "NotFound", r.errCode())

	require.Equal(t, 204, e.do("DELETE", "/_s3lab/faults", "").Code)
	require.Empty(t, e.faults.List())
}

func TestReset(t *testing.T) {
	dir := t.TempDir()
	require.NoError(t, os.MkdirAll(filepath.Join(dir, "seeded"), 0o755))
	require.NoError(t, os.WriteFile(filepath.Join(dir, "seeded", "f.txt"), []byte("seed"), 0o644))
	var backend storage.Backend
	e := newEnv(t, func(d *Deps) {
		backend = d.Backend
		d.Seeder = seed.New(backend, []string{"declared"}, dir)
	})
	ctx := context.Background()
	e.mustBucket("scratch")
	e.mustPut("scratch", "a", "x", "")
	require.NoError(t, e.backend.CreateBucket(ctx, "seeded"))
	e.mustPut("seeded", "extra", "x", "")
	e.reqs.Add(reqlog.Entry{Method: "GET"})
	_, err := e.faults.Add(faults.Rule{ID: "r", Status: 500})
	require.NoError(t, err)

	r := e.do("POST", "/_s3lab/reset?bucket=seeded", "")
	require.Equal(t, 204, r.Code)
	res, err := backend.ListObjects(ctx, "seeded", storage.ListOptions{})
	require.NoError(t, err)
	require.Len(t, res.Objects, 1)
	require.Equal(t, "f.txt", res.Objects[0].Key)
	_, err = backend.HeadObject(ctx, "scratch", "a")
	require.NoError(t, err)
	require.Len(t, e.reqs.List(reqlog.Filter{}), 1)
	require.Len(t, e.faults.List(), 1)

	require.Equal(t, 404, e.do("POST", "/_s3lab/reset?bucket=nope", "").Code)

	require.Equal(t, 204, e.do("POST", "/_s3lab/reset?requests=true&faults=true", "").Code)
	_, err = backend.HeadBucket(ctx, "scratch")
	require.ErrorIs(t, err, storage.ErrNoSuchBucket)
	_, err = backend.HeadBucket(ctx, "declared")
	require.NoError(t, err)
	_, err = backend.HeadObject(ctx, "seeded", "f.txt")
	require.NoError(t, err)
	require.Empty(t, e.reqs.List(reqlog.Filter{}))
	require.Empty(t, e.faults.List())
}

func TestResetWithoutSeeder(t *testing.T) {
	e := newEnv(t)
	e.mustBucket("scratch")
	require.Equal(t, 204, e.do("POST", "/_s3lab/reset", "").Code)
	b, err := e.backend.ListBuckets(context.Background())
	require.NoError(t, err)
	require.Empty(t, b)
}

func TestResetSeedFailure(t *testing.T) {
	e := newEnv(t, func(d *Deps) {
		d.Seeder = seed.New(d.Backend, nil, filepath.Join(t.TempDir(), "missing"))
	})
	r := e.do("POST", "/_s3lab/reset", "")
	require.Equal(t, 500, r.Code)
	require.Equal(t, "InternalError", r.errCode())
}

func TestStaticAndFallback(t *testing.T) {
	e := newEnv(t)
	r := e.do("GET", "/", "")
	require.Equal(t, 200, r.Code)
	require.Contains(t, r.Body.String(), "<html")
	require.Equal(t, "no-cache", r.Header().Get("Cache-Control"))

	spa := e.do("GET", "/buckets/photos/some/deep/path", "")
	require.Equal(t, 200, spa.Code)
	require.Equal(t, r.Body.String(), spa.Body.String())
	require.Equal(t, "no-cache", spa.Header().Get("Cache-Control"))
	require.Equal(t, r.Body.String(), e.do("GET", "/views", "").Body.String())

	js := e.do("GET", "/api.js", "")
	require.Equal(t, 200, js.Code)
	require.Contains(t, js.Body.String(), "/_s3lab")
	require.Empty(t, js.Header().Get("Cache-Control"))

	r = e.do("GET", "/_s3lab/nope", "")
	require.Equal(t, 404, r.Code)
	require.Equal(t, "NotFound", r.errCode())
	r = e.do("POST", "/_s3lab/health", "")
	require.Equal(t, 404, r.Code)

	r = e.do("POST", "/anything", "")
	require.Equal(t, 405, r.Code)
	require.Equal(t, "MethodNotAllowed", r.errCode())
}

func TestCrossOrigin(t *testing.T) {
	e := newEnv(t)
	body := `{"name":"photos"}`
	r := e.do("POST", "/_s3lab/buckets", body, "Origin", "http://evil.example")
	require.Equal(t, 403, r.Code)
	require.Equal(t, "Forbidden", r.errCode())
	require.Equal(t, 403, e.do("POST", "/_s3lab/buckets", body, "Origin", "null").Code)
	require.Equal(t, 403, e.do("DELETE", "/_s3lab/requests", "", "Origin", "http://localhost:9001x").Code)

	require.Equal(t, 201, e.do("POST", "/_s3lab/buckets", body, "Origin", "http://localhost:9001").Code)
	require.Equal(t, 200, e.do("GET", "/_s3lab/buckets", "", "Origin", "http://evil.example").Code)
	require.Equal(t, 204, e.do("DELETE", "/_s3lab/requests", "").Code)
}

type panicBackend struct{ storage.Backend }

func (panicBackend) ListBuckets(context.Context) ([]storage.Bucket, error) { panic("boom") }

func TestRecover(t *testing.T) {
	e := newEnv(t, func(d *Deps) { d.Backend = panicBackend{d.Backend} })
	r := e.do("GET", "/_s3lab/buckets", "")
	require.Equal(t, 500, r.Code)
	require.Equal(t, "InternalError", r.errCode())
}

type errBackend struct{ storage.Backend }

func (errBackend) ListBuckets(context.Context) ([]storage.Bucket, error) {
	return nil, io.ErrUnexpectedEOF
}

func TestInternalError(t *testing.T) {
	e := newEnv(t, func(d *Deps) { d.Backend = errBackend{d.Backend} })
	r := e.do("GET", "/_s3lab/buckets", "")
	require.Equal(t, 500, r.Code)
	require.Equal(t, "InternalError", r.errCode())
}

// SSE

type sseClient struct {
	t      *testing.T
	cancel context.CancelFunc
	resp   *http.Response
	lines  chan string
	done   chan struct{}
}

func openStream(t *testing.T, e *env, query string, hdr ...string) *sseClient {
	t.Helper()
	srv := httptest.NewServer(e.h)
	t.Cleanup(srv.Close)
	ctx, cancel := context.WithCancel(context.Background())
	t.Cleanup(cancel)
	req, err := http.NewRequestWithContext(ctx, "GET", srv.URL+"/_s3lab/requests/stream"+query, nil)
	require.NoError(t, err)
	for i := 0; i+1 < len(hdr); i += 2 {
		req.Header.Set(hdr[i], hdr[i+1])
	}
	res, err := http.DefaultClient.Do(req)
	require.NoError(t, err)
	c := &sseClient{t: t, cancel: cancel, resp: res, lines: make(chan string, 100), done: make(chan struct{})}
	go func() {
		defer close(c.done)
		defer close(c.lines)
		sc := bufio.NewScanner(res.Body)
		for sc.Scan() {
			c.lines <- sc.Text()
		}
	}()
	t.Cleanup(func() { _ = res.Body.Close() })
	return c
}

func (c *sseClient) next() string {
	c.t.Helper()
	select {
	case l, ok := <-c.lines:
		require.True(c.t, ok, "stream closed")
		return l
	case <-time.After(3 * time.Second):
		c.t.Fatal("timeout waiting for SSE line")
		return ""
	}
}

// event reads the next request event and returns its id and decoded data.
func (c *sseClient) event() (string, map[string]any) {
	c.t.Helper()
	for {
		l := c.next()
		if l != "event: request" {
			continue
		}
		id := strings.TrimPrefix(c.next(), "id: ")
		data := strings.TrimPrefix(c.next(), "data: ")
		var m map[string]any
		require.NoError(c.t, json.Unmarshal([]byte(data), &m))
		return id, m
	}
}

func TestStreamReplayAndLive(t *testing.T) {
	e := newEnv(t)
	for i := range 3 {
		e.reqs.Add(reqlog.Entry{Method: "GET", Op: "GetObject", Bucket: "a", Status: 200 + i})
	}
	c := openStream(t, e, "?since=1")
	require.Equal(t, "text/event-stream", c.resp.Header.Get("Content-Type"))
	require.Equal(t, "no-cache", c.resp.Header.Get("Cache-Control"))
	require.Equal(t, "no", c.resp.Header.Get("X-Accel-Buffering"))

	id, m := c.event()
	require.Equal(t, "2", id)
	require.Equal(t, float64(2), m["id"])
	id, _ = c.event()
	require.Equal(t, "3", id)

	e.reqs.Add(reqlog.Entry{Method: "PUT", Op: "PutObject", Time: time.Date(2026, 1, 1, 0, 0, 0, 5e6, time.UTC)})
	id, m = c.event()
	require.Equal(t, "4", id)
	require.Equal(t, "PutObject", m["op"])
	require.Equal(t, "2026-01-01T00:00:00.005Z", m["time"])
}

func TestStreamLastEventIDWins(t *testing.T) {
	e := newEnv(t)
	for range 4 {
		e.reqs.Add(reqlog.Entry{Method: "GET", Status: 200})
	}
	c := openStream(t, e, "?since=0", "Last-Event-ID", "3")
	id, _ := c.event()
	require.Equal(t, "4", id)
}

func TestStreamFilter(t *testing.T) {
	e := newEnv(t)
	e.reqs.Add(reqlog.Entry{Method: "GET", Bucket: "a", Status: 200})
	e.reqs.Add(reqlog.Entry{Method: "GET", Bucket: "a", Status: 500})
	c := openStream(t, e, "?errors=true&bucket=a&limit=1")
	id, _ := c.event()
	require.Equal(t, "2", id)

	e.reqs.Add(reqlog.Entry{Method: "GET", Bucket: "a", Status: 200})
	e.reqs.Add(reqlog.Entry{Method: "GET", Bucket: "b", Status: 500})
	e.reqs.Add(reqlog.Entry{Method: "GET", Bucket: "a", Status: 503})
	id, _ = c.event()
	require.Equal(t, "5", id)
}

func TestStreamBadFilter(t *testing.T) {
	e := newEnv(t)
	require.Equal(t, 400, e.do("GET", "/_s3lab/requests/stream?status=x", "").Code)
}

func TestStreamPingAndDisconnect(t *testing.T) {
	e := newEnv(t, func(d *Deps) { d.pingInterval = 20 * time.Millisecond })
	c := openStream(t, e, "")
	for c.next() != ": ping" {
	}
	c.cancel()
	_ = c.resp.Body.Close()
	select {
	case <-c.done:
	case <-time.After(3 * time.Second):
		t.Fatal("stream reader did not finish")
	}
}

func TestStreamHandlerReturnsOnDisconnect(t *testing.T) {
	e := newEnv(t)
	ctx, cancel := context.WithCancel(context.Background())
	req := httptest.NewRequest("GET", "/_s3lab/requests/stream", nil).WithContext(ctx)
	req.Host = "localhost"
	rec := httptest.NewRecorder()
	finished := make(chan struct{})
	go func() {
		e.h.ServeHTTP(rec, req)
		close(finished)
	}()
	time.Sleep(50 * time.Millisecond)
	cancel()
	select {
	case <-finished:
	case <-time.After(3 * time.Second):
		t.Fatal("handler did not return after context cancel")
	}
}

func TestContentDispositionHelpers(t *testing.T) {
	require.Equal(t, `attachment; filename="a.txt"`, contentDisposition("attachment", "a.txt"))
	require.Equal(t, `inline; filename="a_b"; filename*=UTF-8''a%01b`, contentDisposition("inline", "a\x01b"))
	require.Equal(t, "a%25b", rfc5987("a%b"))
}

func TestHostGuard(t *testing.T) {
	e := newEnv(t, func(d *Deps) { d.AllowedHosts = []string{"S3Lab.Example.com"} })
	for host, want := range map[string]int{
		"localhost:9001":       200,
		"127.0.0.1":            200,
		"[::1]:9001":           200,
		"s3:9001":              200,
		"app.localhost":        200,
		"box.local":            200,
		"svc.test":             200,
		"db.internal":          200,
		"host.docker.internal": 200,
		"s3lab.example.com:80": 200,
		"attacker.com":         403,
		"attacker.com:9001":    403,
		"localhost.evil.com":   403,
	} {
		req := httptest.NewRequest("GET", "/_s3lab/buckets", nil)
		req.Host = host
		rec := httptest.NewRecorder()
		e.h.ServeHTTP(rec, req)
		require.Equal(t, want, rec.Code, host)
		if want == 403 {
			require.JSONEq(t, `{"error":{"code":"Forbidden","message":"host not allowed; set S3LAB_CONSOLE_ALLOWED_HOSTS"}}`, rec.Body.String())
		}
	}
	req := httptest.NewRequest("GET", "/", nil)
	req.Host = "attacker.com"
	rec := httptest.NewRecorder()
	e.h.ServeHTTP(rec, req)
	require.Equal(t, 200, rec.Code)
}

func TestPutObjectTooLarge(t *testing.T) {
	e := newEnv(t, func(d *Deps) { d.MaxObjectSize = 4 })
	require.NoError(t, e.backend.CreateBucket(context.Background(), "b"))
	require.Equal(t, 201, e.do("PUT", "/_s3lab/buckets/b/object?key=ok", "1234").Code)

	r := e.do("PUT", "/_s3lab/buckets/b/object?key=big", "12345")
	require.Equal(t, 413, r.Code)
	require.Equal(t, "EntityTooLarge", r.errCode())

	req := httptest.NewRequest("PUT", "/_s3lab/buckets/b/object?key=chunked", io.NopCloser(strings.NewReader("12345678")))
	req.Host = "localhost"
	require.Equal(t, int64(-1), req.ContentLength)
	rec := httptest.NewRecorder()
	e.h.ServeHTTP(rec, req)
	require.Equal(t, 413, rec.Code)
	require.Contains(t, rec.Body.String(), "EntityTooLarge")
}

type notEmptyOnce struct {
	storage.Backend
	left  int
	calls int
}

func (b *notEmptyOnce) DeleteBucket(ctx context.Context, name string) error {
	b.calls++
	if b.left > 0 {
		b.left--
		return storage.ErrBucketNotEmpty
	}
	return b.Backend.DeleteBucket(ctx, name)
}

func TestForceDeleteRetries(t *testing.T) {
	var fb *notEmptyOnce
	e := newEnv(t, func(d *Deps) {
		fb = &notEmptyOnce{Backend: d.Backend, left: 2}
		d.Backend = fb
	})
	require.NoError(t, e.backend.CreateBucket(context.Background(), "b"))
	require.Equal(t, 204, e.do("DELETE", "/_s3lab/buckets/b?force=true", "").Code)
	require.Equal(t, 3, fb.calls)

	require.NoError(t, e.backend.CreateBucket(context.Background(), "c"))
	fb.left, fb.calls = 5, 0
	r := e.do("DELETE", "/_s3lab/buckets/c?force=true", "")
	require.Equal(t, 409, r.Code)
	require.Equal(t, 3, fb.calls)

	fb.calls = 0
	require.Equal(t, 409, e.do("DELETE", "/_s3lab/buckets/c", "").Code)
	require.Equal(t, 1, fb.calls)
}

func TestStreamStopsOnDone(t *testing.T) {
	done := make(chan struct{})
	e := newEnv(t, func(d *Deps) { d.Done = done })
	req := httptest.NewRequest("GET", "/_s3lab/requests/stream", nil)
	req.Host = "localhost"
	finished := make(chan struct{})
	go func() {
		e.h.ServeHTTP(httptest.NewRecorder(), req)
		close(finished)
	}()
	time.Sleep(50 * time.Millisecond)
	close(done)
	select {
	case <-finished:
	case <-time.After(3 * time.Second):
		t.Fatal("stream did not stop on Done")
	}
}
